# SigNoz Cloud Configuration
# Get these credentials from your SigNoz Cloud account:
# Settings -> Ingestion Keys -> Region & Ingestion Key

# SigNoz Ingestion Endpoint (e.g., https://ingest.us.signoz.cloud or http://localhost:4318)
SIGNOZ_ENDPOINT=https://ingest.us.signoz.cloud

# SigNoz Ingestion Key (from SigNoz Cloud Settings -> Ingestion Keys)
SIGNOZ_INGESTION_KEY=your-signoz-ingestion-key-here

# Optional: Standard OTEL environment variables (fallback)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS={"signoz-ingestion-key":"your-signoz-ingestion-key-here"}

# Server Port
PORT=4000
